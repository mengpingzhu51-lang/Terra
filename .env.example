# Required for OpenRouter AI calls.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
LANGGRAPH_LLM_BASE_URL="https://openrouter.ai/api/v1"
LANGGRAPH_LLM_MODEL="moonshotai/kimi-k2"

# Required for Supabase persistence.
NEXT_PUBLIC_SUPABASE_URL="MY_SUPABASE_URL"
NEXT_PUBLIC_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# Optional public app URL for OpenRouter request metadata and callbacks.
APP_URL="MY_APP_URL"

# Required for Google Sign-In.
GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID"
